<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nts_blue_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/nts_blue" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nts_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/nts_blue_line" />
            <corners android:radius="18dp" />
        </shape>
    </item>

</selector>
