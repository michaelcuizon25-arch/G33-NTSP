<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer" />

    <!-- BOTTOM NAV PILL -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavContainer"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="36dp"
        app:cardElevation="5dp"
        app:strokeColor="#F0F0F0"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <!-- HOME -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item_inactive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconHome"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="Home"
                    android:src="@drawable/ic_home"
                    app:tint="#777777" />

                <TextView
                    android:id="@+id/textHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Home"
                    android:textColor="#555555"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- NOTES -->
            <LinearLayout
                android:id="@+id/navNotes"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item_inactive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconNotes"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="Notes"
                    android:src="@drawable/ic_notes"
                    app:tint="#777777" />

                <TextView
                    android:id="@+id/textNotes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Notes"
                    android:textColor="#555555"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- CENTER SLOT: LABEL ONLY -->
            <LinearLayout
                android:id="@+id/navScanSlot"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1.12"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="45dp">

                <TextView
                    android:id="@+id/textScan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Scan"
                    android:textColor="#111111"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- HISTORY -->
            <LinearLayout
                android:id="@+id/navHistory"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item_inactive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconHistory"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="History"
                    android:src="@drawable/ic_history"
                    app:tint="#777777" />

                <TextView
                    android:id="@+id/textHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="History"
                    android:textColor="#555555"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- SETTINGS -->
            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item_inactive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconSettings"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_setting"
                    app:tint="#777777" />

                <TextView
                    android:id="@+id/textSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Settings"
                    android:textColor="#555555"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- CENTER SCAN LENS -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/scanFab"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="39dp"
        app:cardElevation="8dp"
        app:strokeColor="#D7D7D7"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottomNavContainer"
        android:translationY="-26dp">

        <ImageView
            android:id="@+id/iconScan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Scan"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_scan_lens_custom" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
