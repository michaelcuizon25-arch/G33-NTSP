<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nts_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="30dp"
            android:paddingEnd="28dp"
            android:paddingBottom="100dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/apple_garamond_italic"
                android:text="Notes"
                android:textColor="@color/nts_text"
                android:textSize="32sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTitleNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOTE" />

                <TextView
                    android:id="@+id/tvTitle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2" />

                <TextView
                    android:id="@+id/tvTitleSnap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SNAP" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="15dp"
                app:cardBackgroundColor="@color/nts_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/nts_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Search"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="@color/nts_text_secondary" />

                    <EditText
                        android:id="@+id/etSearchNotes"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/poppins_regular"
                        android:hint="Search notes or folders"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:padding="0dp"
                        android:textColor="@color/nts_text"
                        android:textColorHint="@color/nts_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_filter_active"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:text="All"
                        android:textColor="@color/nts_text"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/chipNotes"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:text="Notes"
                        android:textColor="@color/nts_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/chipFolders"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:text="Folders"
                        android:textColor="@color/nts_text_secondary"
                        android:textSize="11sp" />

                </LinearLayout>
            </HorizontalScrollView>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvResultCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/nts_text_secondary"
                    android:textSize="10.5sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnSort"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Sort"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        app:tint="@color/nts_text_secondary" />

                    <ImageView
                        android:id="@+id/btnViewMode"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="View mode"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="@color/nts_text_secondary" />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/emptyStateContainer"
                android:layout_width="match_parent"
                android:layout_height="205dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieEmptyNotesRobot"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:contentDescription="Sad Note2Snap robot"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/robot_sad"
                    app:lottie_speed="0.75" />

                <TextView
                    android:id="@+id/tvNotFound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="No saved notes yet"
                    android:textColor="@color/nts_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvEmptyNotesSubtitle"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="Scans stay in History until you tap Save."
                    android:textColor="@color/nts_blue"
                    android:textSize="10.5sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvFoldersLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Folders"
                android:textColor="@color/nts_text"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFolders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvNotesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Notes"
                android:textColor="@color/nts_text"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddNotes"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="18dp"
        android:contentDescription="Add Notes"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/nts_yellow"
        app:borderWidth="1dp"
        app:elevation="4dp"
        app:tint="@color/nts_text" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/notesSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="88dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/nts_surface"
        app:cardCornerRadius="22dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/nts_blue_line"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/tvNotesSelectedCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="1 selected"
                android:textColor="@color/nts_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnNotesSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Select all"
                android:textColor="@color/nts_blue"
                android:fontFamily="@font/poppins_medium"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/btnNotesDeleteSelected"
                android:layout_width="78dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_delete_button"
                android:gravity="center"
                android:text="Delete"
                android:textColor="@android:color/white"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnNotesCancelSelection"
                android:layout_width="36dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/nts_text_secondary"
                android:textSize="20sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>