<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sampleDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sample_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:id="@+id/ivSampleWhiteboard"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="@drawable/bg_sample_preview"
        android:clipToOutline="true"
        android:contentDescription="Sample whiteboard"
        android:scaleType="centerCrop"
        android:src="@drawable/sample_whiteboard_demo" />

    <TextView
        android:id="@+id/tvSampleTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="New here? Try a sample whiteboard"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvSampleBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins_regular"
        android:text="See how Note2Snap works before using your own photo. The sample will go through the real scan process."
        android:textColor="#D6D9E0"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSampleLater"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_sample_secondary"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="Maybe later"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <View
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnTrySample"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.18"
            android:background="@drawable/bg_sample_primary"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="Try sample"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
