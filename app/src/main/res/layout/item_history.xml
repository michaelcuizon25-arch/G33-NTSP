<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/nts_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/nts_card_outline_soft"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/historyItemRoot"
        android:layout_width="match_parent"
        android:layout_height="74dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/historyThumbCard"
            android:layout_width="58dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            app:cardBackgroundColor="@color/nts_surface_blue_soft"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/nts_blue_line"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivHistoryThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="false"
                android:contentDescription="Scan thumbnail"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_note_custom" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvHistoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semibold"
            android:maxLines="1"
            android:textColor="@color/nts_text"
            android:textSize="11.5sp"
            app:layout_constraintEnd_toStartOf="@id/tvHistoryDate"
            app:layout_constraintStart_toEndOf="@id/historyThumbCard"
            app:layout_constraintTop_toTopOf="@id/historyThumbCard"
            tools:text="Inheritance" />

        <ImageView
            android:id="@+id/ivLocalStatus"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginStart="11dp"
            android:layout_marginTop="5dp"
            android:src="@android:drawable/ic_menu_save"
            app:layout_constraintStart_toEndOf="@id/historyThumbCard"
            app:layout_constraintTop_toBottomOf="@id/tvHistoryTitle"
            app:tint="@color/nts_blue" />

        <TextView
            android:id="@+id/tvHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Saved locally"
            android:textColor="@color/nts_text_secondary"
            android:textSize="8sp"
            app:layout_constraintBottom_toBottomOf="@id/ivLocalStatus"
            app:layout_constraintStart_toEndOf="@id/ivLocalStatus"
            app:layout_constraintTop_toTopOf="@id/ivLocalStatus" />

        <TextView
            android:id="@+id/tvHistoryPageCount"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_page_count_badge"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:text="3 pages"
            android:textColor="@color/nts_blue"
            android:textSize="7sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/ivLocalStatus"
            app:layout_constraintStart_toEndOf="@id/tvHistoryStatus"
            app:layout_constraintTop_toTopOf="@id/ivLocalStatus"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvHistoryDate"
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:fontFamily="@font/poppins_regular"
            android:maxLines="1"
            android:textColor="@color/nts_text_secondary"
            android:textSize="8sp"
            app:layout_constraintBottom_toBottomOf="@id/historyThumbCard"
            app:layout_constraintEnd_toStartOf="@id/btnHistoryMore"
            app:layout_constraintTop_toTopOf="@id/historyThumbCard"
            tools:text="Oct 10, 2026" />

        <ImageButton
            android:id="@+id/btnHistoryMore"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:alpha="0.72"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="History options"
            android:padding="6dp"
            android:src="@drawable/ic_tool_more"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/nts_text_secondary" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
