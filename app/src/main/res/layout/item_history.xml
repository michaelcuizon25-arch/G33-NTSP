<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    app:cardBackgroundColor="@color/nts_surface_blue_soft"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/nts_outline"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/historyItemRoot"
        android:layout_width="match_parent"
        android:layout_height="68dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/historyThumbCard"
            android:layout_width="50dp"
            android:layout_height="38dp"
            android:layout_marginStart="9dp"
            app:cardBackgroundColor="@color/nts_surface"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/nts_blue"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivHistoryThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Scan thumbnail"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_note_custom" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvHistoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_regular"
            android:maxLines="1"
            android:textColor="@color/nts_text"
            android:textSize="12.5sp"
            app:layout_constraintEnd_toStartOf="@id/tvHistoryDate"
            app:layout_constraintStart_toEndOf="@id/historyThumbCard"
            app:layout_constraintTop_toTopOf="@id/historyThumbCard"
            tools:text="Scan 5" />

        <ImageView
            android:id="@+id/ivLocalStatus"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginStart="9dp"
            android:layout_marginTop="1dp"
            android:src="@android:drawable/ic_menu_save"
            app:layout_constraintStart_toEndOf="@id/historyThumbCard"
            app:layout_constraintTop_toBottomOf="@id/tvHistoryTitle"
            app:tint="@color/nts_blue" />

        <TextView
            android:id="@+id/tvHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Synced to Local"
            android:textColor="@color/nts_text_secondary"
            android:textSize="7.5sp"
            app:layout_constraintBottom_toBottomOf="@id/ivLocalStatus"
            app:layout_constraintStart_toEndOf="@id/ivLocalStatus"
            app:layout_constraintTop_toTopOf="@id/ivLocalStatus" />

        <TextView
            android:id="@+id/tvHistoryDate"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:fontFamily="@font/poppins_regular"
            android:maxLines="1"
            android:textColor="@color/nts_text_secondary"
            android:textSize="7.5sp"
            app:layout_constraintBottom_toBottomOf="@id/historyThumbCard"
            app:layout_constraintEnd_toStartOf="@id/btnHistoryMore"
            app:layout_constraintTop_toTopOf="@id/historyThumbCard"
            tools:text="March 17, 2026" />

        <ImageButton
            android:id="@+id/btnHistoryMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="History options"
            android:padding="7dp"
            android:src="@drawable/ic_tool_more"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/nts_text" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>