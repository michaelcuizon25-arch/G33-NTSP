<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🙂"
        android:textSize="56sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Analyzing your Whiteboard"
        android:textColor="@color/text_main"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Hang on!"
        android:textColor="@color/text_main"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="#80FFFFFF"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/tvStep1Check" android:layout_width="24dp" android:layout_height="wrap_content" android:text="○" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enhancing Image" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView android:id="@+id/tvStep2Check" android:layout_width="24dp" android:layout_height="wrap_content" android:text="○" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Detecting Text" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView android:id="@+id/tvStep3Check" android:layout_width="24dp" android:layout_height="wrap_content" android:text="○" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Detecting Elements" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView android:id="@+id/tvStep4Check" android:layout_width="24dp" android:layout_height="wrap_content" android:text="○" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Structuring Notes" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView android:id="@+id/tvStep5Check" android:layout_width="24dp" android:layout_height="wrap_content" android:text="○" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saving" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>