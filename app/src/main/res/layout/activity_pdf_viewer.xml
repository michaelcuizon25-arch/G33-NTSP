<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nts_background"
    android:fitsSystemWindows="true"
    android:forceDarkAllowed="false"
    tools:context=".activities.PdfViewerActivity"
    tools:ignore="HardcodedText,TextContrastCheck,ImageContrastCheck,TouchTargetSizeCheck,SmallSp,UseCompatTextViewDrawableXml,SpeakableTextPresentCheck"
    tools:targetApi="q">

    <!-- COMPACT TWO-ROW HEADER -->
    <LinearLayout
        android:id="@+id/llPdfHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/nts_background"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <!-- TITLE ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="@color/nts_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/nts_blue_line"
                app:strokeWidth="1dp">

                <ImageButton
                    android:id="@+id/btnPdfBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/cd_back"
                    android:padding="11dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/nts_text" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvPdfTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/apple_garamond_bold"
                    android:maxLines="1"
                    android:textColor="@color/nts_text"
                    android:textSize="20sp"
                    tools:text="Scan Sep 27, 2026 13:48" />

                <TextView
                    android:id="@+id/tvPdfDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="1"
                    android:textColor="@color/nts_text_secondary"
                    android:textSize="11sp"
                    tools:text="Sep 27, 2026, 4:18 PM" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="@color/nts_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/nts_blue_line"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/btnPdfMoreOptions"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_more_options"
                    android:padding="11dp"
                    android:src="@drawable/ic_tool_more"
                    app:tint="@color/nts_text" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- EDITOR TOOLS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="4dp"
            app:cardBackgroundColor="@color/nts_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/nts_blue_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <!-- Text -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/pdf_tool_text_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageButton
                        android:id="@+id/btnToolText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="Text blocks"
                        android:padding="11dp"
                        android:src="@drawable/ic_tool_text"
                        app:tint="#4D78E8" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Pen -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/pdf_tool_pen_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageButton
                        android:id="@+id/btnToolPen"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="Pen"
                        android:padding="11dp"
                        android:src="@drawable/ic_tool_pen"
                        app:tint="#6D58B8" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Highlighter -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/pdf_tool_highlighter_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageButton
                        android:id="@+id/btnToolHighlighter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="Highlighter"
                        android:padding="11dp"
                        android:src="@drawable/ic_tool_highlighter"
                        app:tint="#A97B00" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Eraser -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/pdf_tool_eraser_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageButton
                        android:id="@+id/btnToolEraser"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="Eraser"
                        android:padding="11dp"
                        android:src="@drawable/ic_tool_eraser"
                        app:tint="#C15C74" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Undo -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/pdf_tool_neutral_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageButton
                        android:id="@+id/btnToolUndo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="Undo"
                        android:padding="11dp"
                        android:src="@drawable/ic_tool_undo"
                        app:tint="@color/pdf_tool_neutral_tint" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Redo -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/pdf_tool_neutral_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageButton
                        android:id="@+id/btnToolRedo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="Redo"
                        android:padding="11dp"
                        android:src="@drawable/ic_tool_redo"
                        app:tint="@color/pdf_tool_neutral_tint" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- NOTE CONTENT -->
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/llPdfBottomActions"
        android:layout_below="@id/llPdfHeader"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/nts_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/nts_blue_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Original Whiteboard"
                            android:textColor="@color/nts_text"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Source"
                            android:textColor="@color/nts_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardScannedImage"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginBottom="14dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/nts_surface_blue_soft"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/ivScannedImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/cd_scanned_photo"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvSectionHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/apple_garamond_bold"
                        android:textColor="@color/nts_text"
                        android:textSize="18sp"
                        android:visibility="gone"
                        tools:text="1.1 - Introduction to Statistics" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/apple_garamond_bold"
                                android:text="Structured Notes"
                                android:textColor="@color/nts_text"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Editable text with preserved visual annotations"
                                android:textColor="@color/nts_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnExpandText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:minWidth="48dp"
                            android:minHeight="40dp"
                            android:text="Show more"
                            android:textColor="@color/nts_blue"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Text + persistent pen layer -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/pdf_editor_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/nts_blue_line"
                        app:strokeWidth="1dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="150dp"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvPdfContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:lineSpacingExtra="2dp"
                                android:textColor="@color/nts_text"
                                android:textSize="12sp" />

                            <EditText
                                android:id="@+id/etInlineEditor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints=""
                                android:background="@null"
                                android:fontFamily="@font/poppins_regular"
                                android:gravity="top|start"
                                android:hint="@string/hint_edit_content"
                                android:inputType="textMultiLine|textCapSentences"
                                android:lineSpacingExtra="2dp"
                                android:minHeight="150dp"
                                android:padding="0dp"
                                android:textColor="@color/nts_text"
                                android:textColorHint="#9A9AA2"
                                android:textSize="13sp"
                                android:visibility="gone" />

                            <com.example.note2snap.utils.DrawingView
                                android:id="@+id/drawingView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:focusable="true"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- FUTURE STRUCTURED VISUALS / DIAGRAMS -->
                    <LinearLayout
                        android:id="@+id/llDetectedVisuals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/apple_garamond_bold"
                            android:text="Visuals &amp; Diagrams"
                            android:textColor="@color/nts_text"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Preserved drawings and non-text regions from the whiteboard"
                            android:textColor="@color/nts_text_secondary"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/llDetectedVisualItems"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- STICKY ACTION BAR -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/llPdfBottomActions"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/nts_surface"
        app:cardCornerRadius="26dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/nts_blue_line"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/llPageSelector"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPageUp"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="@string/page_up"
                    android:textColor="@color/pdf_action_blue"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvPageIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingHorizontal="3dp"
                    android:textColor="@color/nts_text"
                    android:textSize="11sp"
                    tools:text="1 / 2" />

                <TextView
                    android:id="@+id/btnPageDown"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="@string/page_down"
                    android:textColor="@color/pdf_action_blue"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/llPageSelector"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnActionSaveNotes"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:drawablePadding="4dp"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:minWidth="52dp"
                    android:paddingHorizontal="7dp"
                    android:text="Save"
                    android:textColor="@color/nts_text"
                    android:textSize="11sp"
                    app:drawableStartCompat="@drawable/ic_action_save"
                    app:drawableTint="@color/nts_text" />

                <TextView
                    android:id="@+id/btnActionDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:drawablePadding="4dp"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:paddingHorizontal="6dp"
                    android:text="Export PDF"
                    android:textColor="@color/pdf_action_blue"
                    android:textSize="11sp"
                    app:drawableStartCompat="@drawable/ic_action_export"
                    app:drawableTint="@color/pdf_action_blue" />

                <TextView
                    android:id="@+id/btnActionShare"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:drawablePadding="4dp"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:minWidth="52dp"
                    android:paddingHorizontal="6dp"
                    android:text="Share"
                    android:textColor="@color/nts_text"
                    android:textSize="11sp"
                    app:drawableStartCompat="@drawable/ic_tool_share"
                    app:drawableTint="@color/nts_text" />
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <WebView
        android:id="@+id/webViewContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/llPdfBottomActions"
        android:layout_below="@id/llPdfHeader"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@color/pdf_web_bg"
        android:visibility="gone" />

</RelativeLayout>