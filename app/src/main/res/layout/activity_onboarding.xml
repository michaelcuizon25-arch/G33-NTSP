<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nts_background">

    <TextView
        android:id="@+id/btnOnboardingSkip"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="14dp"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="Skip"
        android:textColor="@color/nts_blue"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/brandBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBrandLogo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="Note2Snap Logo"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/note2snap_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Note2Snap"
            android:textColor="@color/nts_blue"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/speechBubble"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_onboarding_speech"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brandBlock">

        <TextView
            android:id="@+id/tvOnboardingSpeech"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/nts_text"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/robotStage"
        android:layout_width="0dp"
        android:layout_height="230dp"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/speechBubble">

        <View
            android:id="@+id/decorLeftGlow"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_onboarding_decor_blue" />





        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieOnboardingRobot"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_gravity="center"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/robot_mascot" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/onboardingFeatureContainer"
        android:layout_width="0dp"
        android:layout_height="152dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="28dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/robotStage" />

    <TextView
        android:id="@+id/tvOnboardingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="28dp"
        android:fontFamily="@font/apple_garamond_bold"
        android:gravity="center"
        android:lineSpacingExtra="-2dp"
        android:textColor="@color/nts_text"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/onboardingFeatureContainer" />

    <TextView
        android:id="@+id/tvOnboardingSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="38dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:textColor="@color/nts_text_secondary"
        android:textSize="10.5sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvOnboardingTitle" />

    <LinearLayout
        android:id="@+id/pageDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvOnboardingSubtitle">

        <View android:id="@+id/dot1" android:layout_width="8dp" android:layout_height="8dp"/>
        <View android:id="@+id/dot2" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="7dp"/>
        <View android:id="@+id/dot3" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="7dp"/>
        <View android:id="@+id/dot4" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="7dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/onboardingActions"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnOnboardingBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_onboarding_secondary_button"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="←  Back"
            android:textColor="@color/nts_blue"
            android:textSize="12sp" />

        <View android:layout_width="12dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnOnboardingNext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.45"
            android:background="@drawable/bg_onboarding_primary_button"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="Next  →"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>