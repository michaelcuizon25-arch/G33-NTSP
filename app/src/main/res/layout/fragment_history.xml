<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nts_background">

    <TextView
        android:id="@+id/tvHistoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/apple_garamond_italic"
        android:text="History"
        android:textColor="@color/nts_text"
        android:textSize="32sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/historyHeaderLine"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="40dp"
        android:background="@color/nts_blue_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHistoryTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="27dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="27dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="210dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/historyHeaderLine"
        tools:listitem="@layout/item_history" />

    <LinearLayout
        android:id="@+id/llEmptyHistory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="96dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/historyHeaderLine"
        tools:visibility="visible">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieEmptyHistoryRobot"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:contentDescription="Sad Note2Snap robot"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/robot_sad"
            app:lottie_speed="0.75" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Nothing scanned yet"
            android:textColor="@color/nts_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:text="Your scanned whiteboards will appear here."
            android:textColor="@color/nts_text_secondary"
            android:textSize="10.5sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyHistoryScan"
            android:layout_width="142dp"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Scan now"
            android:textAllCaps="false"
            android:textColor="@color/nts_text"
            android:textSize="11sp"
            app:backgroundTint="@color/nts_yellow"
            app:cornerRadius="16dp" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/historySelectionBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="154dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/nts_surface"
        app:cardCornerRadius="22dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/nts_blue_line"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/tvHistorySelectedCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="1 selected"
                android:textColor="@color/nts_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnHistorySelectAll"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Select all"
                android:textColor="@color/nts_blue"
                android:fontFamily="@font/poppins_medium"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/btnHistoryDeleteSelected"
                android:layout_width="78dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_delete_button"
                android:gravity="center"
                android:text="Delete"
                android:textColor="@android:color/white"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnHistoryCancelSelection"
                android:layout_width="36dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/nts_text_secondary"
                android:textSize="20sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
