<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- FULL CAMERA PREVIEW BEHIND THE CENTERED WHITEBOARD FRAME -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#111111"
        app:implementationMode="compatible"
        app:scaleType="fillCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- CENTERED LANDSCAPE WHITEBOARD GUIDE -->
    <View
        android:id="@+id/viewFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_camera_frame"
        android:elevation="2dp"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintDimensionRatio="4:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48" />

    <!--
        Frosted-looking camera surroundings.
        The live camera remains visible underneath, so these areas do not look plain black.
    -->
    <View
        android:id="@+id/frostTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A6000000"
        android:elevation="1dp"
        app:layout_constraintBottom_toTopOf="@id/viewFrame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/frostBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A6000000"
        android:elevation="1dp"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewFrame" />

    <View
        android:id="@+id/frostLeft"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        android:elevation="1dp"
        app:layout_constraintBottom_toBottomOf="@id/viewFrame"
        app:layout_constraintEnd_toStartOf="@id/viewFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/viewFrame" />

    <View
        android:id="@+id/frostRight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        android:elevation="1dp"
        app:layout_constraintBottom_toBottomOf="@id/viewFrame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/viewFrame"
        app:layout_constraintTop_toTopOf="@id/viewFrame" />

    <!-- Back Button Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/backButtonContainer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#99000000"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Flash Control Pill Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/flashControl"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#EEFFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btnFlash"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Flash toggle icon"
                android:src="@drawable/ic_flash"
                app:tint="#5A7FDB" />

            <TextView
                android:id="@+id/tvFlashState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/poppins_medium"
                android:text="Off"
                android:textColor="#171717"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#D1000000"
        android:elevation="4dp"
        android:fontFamily="@font/poppins_regular"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="Keep the whole whiteboard inside the frame"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewFrame"
        tools:ignore="HardcodedText" />


    <!-- CAMERA BATCH TRAY
         Hidden for normal single camera preview; appears only after a valid capture.
         This is an overlay and does not replace the original camera controls. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cameraBatchTray"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:elevation="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F20C0C0C"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeColor="#665A7FDB"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCameraBatchCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="1 page ready"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    tools:ignore="HardcodedText" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="5dp"
                    android:layout_weight="1"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/cameraBatchThumbnails"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnProcessCameraBatch"
                android:layout_width="94dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#AFC4F6"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvProcessCameraBatch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="Process"
                    android:textColor="#171717"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="#000000"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Capture mode tabs: text-based like a camera mode selector, not a switch. -->
        <LinearLayout
            android:id="@+id/captureModeTabs"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnSingleMode"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/tvSingleMode"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="Single"
                    android:textColor="#AFC4F6"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText" />

                <View
                    android:id="@+id/indicatorSingleMode"
                    android:layout_width="28dp"
                    android:layout_height="2dp"
                    android:background="#AFC4F6" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnBatchMode"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/tvBatchMode"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="Batch"
                    android:textColor="#8A8A92"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText" />

                <View
                    android:id="@+id/indicatorBatchMode"
                    android:layout_width="28dp"
                    android:layout_height="2dp"
                    android:background="#AFC4F6"
                    android:visibility="invisible" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="30dp"
            android:paddingEnd="30dp">

            <LinearLayout
                android:id="@+id/btnGallery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Open Gallery"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="#AFC4F6" />

            </LinearLayout>

            <!-- Clean Circular Camera Shutter (No Icon Overlay) -->
            <FrameLayout
                android:id="@+id/btnCapture"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:clickable="true"
                android:contentDescription="Take Photo"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <View
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter_outer" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter_inner" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvCancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/poppins_medium"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="Cancel"
                android:textColor="#FF4D5D"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>

    <!-- ANALYZING OVERLAY -->
    <LinearLayout
        android:id="@+id/analyzingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        android:elevation="50dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="38dp"
        android:paddingTop="120dp"
        android:paddingEnd="38dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivAnalyzingIcon"
            android:layout_width="160dp"
            android:layout_height="130dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="true"
            android:contentDescription="Analyzing icon"
            android:scaleType="centerInside"
            android:src="@drawable/ic_analysis_face" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/apple_garamond_italic"
            android:gravity="center"
            android:text="Analyzing your Whiteboard"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:text="Hang on! This may take a few seconds."
            android:textColor="#F2F2F2"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tvCameraBatchProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="Processing 1 of 3"
            android:textColor="#AFC4F6"
            android:textSize="11sp"
            android:visibility="gone"
            tools:ignore="HardcodedText" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="28dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStepEnhance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="Enhancing Image"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/iconEnhance"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_analysis_pending"
                android:gravity="center"
                android:text="1"
                android:textColor="#8A8A92"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#77FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStepText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="Detecting Texts"
                android:textColor="#EDEDED"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/iconText"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_analysis_pending"
                android:gravity="center"
                android:text="2"
                android:textColor="#8A8A92"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#77FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStepElements"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="Detecting Elements"
                android:textColor="#EDEDED"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/iconElements"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_analysis_pending"
                android:gravity="center"
                android:text="3"
                android:textColor="#8A8A92"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#77FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStepStructure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="Structuring Notes"
                android:textColor="#EDEDED"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/iconStructure"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_analysis_pending"
                android:gravity="center"
                android:text="4"
                android:textColor="#8A8A92"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#77FFFFFF" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBarScan"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>