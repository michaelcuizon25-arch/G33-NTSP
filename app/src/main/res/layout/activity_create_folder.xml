<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nts_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="34dp">

        <ImageButton
            android:id="@+id/btnBackCreateFolder"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip_unselected"
            android:contentDescription="Back"
            android:padding="11dp"
            android:src="@drawable/ic_back"
            app:tint="@color/nts_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/apple_garamond_italic"
            android:text="Create Folder"
            android:textColor="@color/nts_text"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Choose a name and color for your folder."
            android:textColor="@color/nts_text_secondary"
            android:textSize="11sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/nts_surface_mint"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nts_outline"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivFolderPreview"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:contentDescription="Folder preview"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_folder_cute"
                app:tint="#AFC4F6" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Folder color"
            android:textColor="@color/nts_text"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <View
                    android:id="@+id/colorBlue"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_folder_color_blue" />

                <View
                    android:id="@+id/colorGreen"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_folder_color_green" />

                <View
                    android:id="@+id/colorYellow"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_folder_color_yellow" />

                <View
                    android:id="@+id/colorPurple"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_folder_color_purple" />

                <View
                    android:id="@+id/colorPink"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_folder_color_pink" />

                <View
                    android:id="@+id/colorOrange"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_folder_color_orange" />

                <View
                    android:id="@+id/colorRed"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_folder_color_red" />

                <View
                    android:id="@+id/colorGray"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_folder_color_gray" />

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Folder name"
            android:textColor="@color/nts_text"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="9dp"
            app:cardBackgroundColor="@color/nts_surface"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nts_outline"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/etFolderName"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="@font/poppins_regular"
                android:hint="Enter folder name"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/nts_text"
                android:textColorHint="@color/nts_text_secondary"
                android:textSize="12sp" />

        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnCreateFolder"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/nts_yellow"
            android:fontFamily="@font/poppins_regular"
            android:text="Create Folder"
            android:textAllCaps="false"
            android:textColor="@color/nts_text"
            android:textSize="13sp"
            app:cornerRadius="15dp"
            app:strokeColor="@color/nts_outline"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>