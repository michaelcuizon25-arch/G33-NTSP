<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNote"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/nts_surface_blue"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/nts_outline"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:paddingStart="9dp"
        android:paddingEnd="7dp">

        <ImageView
            android:id="@+id/ivNoteThumbnail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/cd_note_thumbnail"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_note_custom" />

        <LinearLayout
            android:id="@+id/layoutNoteActions"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_favorite"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_star_outline_custom" />

            <ImageButton
                android:id="@+id/btnNoteMore"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="1dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_options"
                android:padding="5dp"
                android:src="@drawable/ic_tool_more"
                app:tint="@color/nts_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="9dp"
            android:layout_toEndOf="@id/ivNoteThumbnail"
            android:layout_toStartOf="@id/layoutNoteActions"
            android:orientation="vertical"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tvNoteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:maxLines="1"
                android:textColor="@color/nts_text"
                android:textSize="11.5sp"
                tools:text="Scan Sep 24, 2026 21:22" />

            <TextView
                android:id="@+id/tvNotePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:maxLines="1"
                android:textColor="@color/nts_text_secondary"
                android:textSize="8.5sp"
                tools:text="Key ideas and structured content from the scanned whiteboard…" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNoteDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="1"
                    android:textColor="@color/nts_text_secondary"
                    android:textSize="8.5sp"
                    tools:text="September 24, 2026" />

                <TextView
                    android:id="@+id/tvNotePageBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_filter_active"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="3 pages"
                    android:textColor="@color/nts_blue"
                    android:textSize="8sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>


        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>