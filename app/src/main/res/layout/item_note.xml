<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNote"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/nts_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/nts_card_outline_soft"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:paddingStart="10dp"
        android:paddingEnd="7dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/noteThumbCard"
            android:layout_width="58dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="@color/nts_surface_blue_soft"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nts_blue_line"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivNoteThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="false"
                android:contentDescription="@string/cd_note_thumbnail"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_note_custom" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/layoutNoteActions"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:alpha="0.72"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_favorite"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_star_outline_custom" />

            <ImageButton
                android:id="@+id/btnNoteMore"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:alpha="0.72"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_options"
                android:padding="6dp"
                android:src="@drawable/ic_tool_more"
                app:tint="@color/nts_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="11dp"
            android:layout_toEndOf="@id/noteThumbCard"
            android:layout_toStartOf="@id/layoutNoteActions"
            android:orientation="vertical"
            android:paddingEnd="5dp">

            <TextView
                android:id="@+id/tvNoteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="1"
                android:textColor="@color/nts_text"
                android:textSize="11.5sp"
                tools:text="Batch Scan" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNoteDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="1"
                    android:textColor="@color/nts_text_secondary"
                    android:textSize="8.5sp"
                    tools:text="Oct 10, 2026" />

                <TextView
                    android:id="@+id/tvPageCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_page_count_badge"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="3 pages"
                    android:textColor="@color/nts_blue"
                    android:textSize="7sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
