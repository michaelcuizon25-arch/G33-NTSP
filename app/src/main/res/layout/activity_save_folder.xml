<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvSaveTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select File"
        android:textColor="@color/text_main"
        android:textSize="22sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgFolders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvSaveTitle"
        android:layout_marginTop="20dp">

        <RadioButton
            android:id="@+id/rbCS101"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CS101" />

        <RadioButton
            android:id="@+id/rbCS102"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CS102" />

        <RadioButton
            android:id="@+id/rbDataStructure"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Data Structure" />

        <RadioButton
            android:id="@+id/rbProgrammingNotes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Programming Notes" />

        <RadioButton
            android:id="@+id/rbALG101"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="ALG101" />
    </RadioGroup>

    <Button
        android:id="@+id/btnSaveNote"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:backgroundTint="@color/secondary"
        android:text="Save Note"
        android:textColor="@color/text_main"
        android:textStyle="bold" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddFolderInSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnSaveNote"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="16dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/primary" />
</RelativeLayout>