<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Note2Snap"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">#6F8FEA</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="colorSecondary">#FFF79A</item>
        <item name="colorOnSecondary">#171717</item>

        <item name="android:colorAccent">#6F8FEA</item>

        <item name="android:windowBackground">#EEF3FF</item>
        <item name="android:statusBarColor">#EEF3FF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

    </style>

    <style name="RoundedSquare" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Theme.Note2Snap.Splash"
        parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/nts_background</item>
        <item name="android:statusBarColor">@color/nts_background</item>
        <item name="android:navigationBarColor">@color/nts_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>